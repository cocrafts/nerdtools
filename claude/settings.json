{
  "permissions": {
    "allow": [
      "Bash(top:*)",
      "Bash(vm_stat)",
      "Bash(sysctl:*)",
      "Bash(launchctl:*)",
      "Bash(sudo ls:*)",
      "Bash(log show:*)",
      "Bash(git log:*)",
      "Bash(linear-server - get_issue:*)",
      "Bash(memory_pressure)",
      "Bash(lsof:*)",
      "Bash(istats:*)",
      "Bash(sudo powermetrics:*)",
      "mcp__exa__web_search_exa"
    ],
    "deny": [],
    "ask": [],
    "defaultMode": "bypassPermissions"
  },
  "disableClaudeAiConnectors": true,
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.codeisland/codeisland-hook.sh",
            "timeout": 86400
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "rexa post claude"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && SUPERSET_AGENT_ID=claude \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.codeisland/codeisland-hook.sh",
            "timeout": 86400
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "rexa post claude"
          }
        ]
      }
    ],
