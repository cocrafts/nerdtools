          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.codeisland/codeisland-hook.sh",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "rexa post claude"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
