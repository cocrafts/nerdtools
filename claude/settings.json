  "enableArtifact": false,
  "enableWorkflows": false,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "lua-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": false,
    "typesafe@typesafe-ai": true
  },
  "extraKnownMarketplaces": {
    "zedra": {
      "source": {
        "source": "github",
        "repo": "tanlethanh/zedra"
      }
    },
    "unity-agent-plugin": {
      "source": {
        "source": "github",
        "repo": "Unity-Technologies/unity-agent-plugin"
      }
    },
    "typesafe-ai": {
      "source": {
        "source": "github",
        "repo": "typesafe-ai/skills"
      }
    }
  },
  "language": "Vietnamese",
  "feedbackDrafts": "off",
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "high"
    },
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "promptSuggestionEnabled": false,
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark-ansi",
  "editorMode": "normal",
  "verbose": false,
  "autoCompactEnabled": true,
  "switchModelsOnFlag": true,
  "autoContinueAtUsageLimit": false,
  "crossSessionInbound": "accept",
  "agentPushNotifEnabled": true,
  "autoMode": {
    "soft_deny": [
      "$defaults",
      "Bash(git stash:*) in /Users/le/metascript/recompiler — repo CLAUDE.md hard-forbids discarding working-tree state (stash/reset/checkout .../restore)",
      "Bash(rm:*) targeting /tmp/verify-parent — shared long-lived worktree the repo docs say must not be removed"
    ],
    "environment": [
