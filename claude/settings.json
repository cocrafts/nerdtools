        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.codeisland/codeisland-hook.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/le/.claude/hooks/herdr-agent-state.sh' session",
